<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="../public/style.css" />
    <title><%=appName%> | Order History</title>
  </head>
  <body>
    <div class="overall">
        <div class="navLine">
            <div class="topNavContainer">
                <div class="navFlex">
                    <div class="navIcons">
                        <a href="">
                            <img src="../public/assets/back_icon.png" alt="Back Icon">
                        </a>
                        <span class="tooltip">thankyou</span>
                    </div>
                    <div class="navHeading">
                        <h1 class="navHead">Order History</h1>
                    </div>
                    <div class="navIcons"></div>
                </div>
            </div>
        </div>
        <main class="addProdMain">
            <div class="orderHistLine">
                <div class="eachOrderHist">
                    <% if (orders && orders.length > 0) { %>
                        <% orders.forEach(order => { %>
                            <div class="orderHistAbove">
                                <div class="orderStatusContainer">
                                    <div class="orderTicket"><p class="orderHistText orderHistTicket"><%= order._id %></p></div>
                                    <div><p class="orderStatus"><%= order.status %></p></div>
                                </div>
                            </div>
                            <div class="orderHistBelow">
                                <div class="orderStatusContainer">
                                    <div><p class="orderDateTime"><%= order.createdAt.toDateString() %></p></div>
                                    <div class="orderTotalAmount"><p class="orderHistText orderHistAmt">&#36; <%= order.totalAmount %></p></div>
                                </div>
                            </div>
                        <% }) %>
                    <% } else { %>
                        <p>No orders found</p>
                    <% } %>
                </div>
            </div>
        </main>
    </div>
  </body>
</html>
