<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="../public/style.css" />
    <title><%=appName%> | Admin Dashboard</title>
  </head>
  <body>
    <div class="overall">
        <header>
            <div class="navContainer">
                <div class="appName">
                    <a href="/home"><%=appName%></a>
                </div>
                <div>
                    <div><%-include("partials/header.ejs")-%></div>
                </div>
            </div>
        </header>
        <div class="prodGrid">
            <% productDetails.forEach(function(productDetail, index) { %>
                <div class="eachProdBox">
                    <div class="dashImages">
                        <div class="prodImage">
                            <img src="<%= productDetail.product_image %>" alt="<%= productDetail.name %>">
                        </div>
                    </div>
                    <div class="eachProdDetails">
                        <div class="eachDashDetails">
                            <h2 class="itemName"><%= productDetail.name %></h2>
                        </div>
                        <div class="eachDashDetails">
                            <p class="itemDesc"><%= productDetail.description %></p>
                        </div>
                        <div class="eachDashDetails">
                            <div><p class="itemPrice">Price: &#36; <%= productDetail.price %> USD</p></div>
                        </div>
                        <div class="eachDashDetails">
                            <div><p class="itemStock">Stock Level: <%= productDetail.stock_level %></p></div>
                        </div>
                    </div>
                    <div class="dashboardAction">
                        <div>
                            <p class="itemAction">Admin Action:</p>
                        </div>
                        <div class="dashActionFlex">
                            <div class="dashActionBtn">
                                <form action="/products/updateState/<%= productDetail._id %>" method="PUT">
                                    <% if (productDetail.product_state === "Hidden") { %>
                                        <input type="hidden" name="product_state" value="Published" />
                                        <button type="submit" formmethod="post" class="eachButton">
                                            Publish
                                        </button>
                                    <% } else { %>
                                        <input type="hidden" name="product_state" value="Hidden" />
                                        <button type="submit" formmethod="post" class="eachButton hideBtn">
                                            Hide Product
                                        </button>
                                    <% } %>
                                </form>
                            </div>
                            <div class="dashActionBtn">
                                <button class="eachButton editBtn">
                                    <a href="/edit/<%= productDetail._id %>" class="editButton">Edit Product</a>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            <% }); %>
        </div>
    </div>
  </body>
</html>
