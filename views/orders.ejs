<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="../public/style.css" />
    <title><%=appName%> | Orders</title>
    <script>
        document.addEventListener("DOMContentLoaded", () => {
            const addButtons = document.querySelectorAll(".plusAdd");
            const removeButtons = document.querySelectorAll(".minusRemove");
            const deliveryCost = 0;


            function updateCart(button, action) {

                const form = button.closest('form');
                const formData = new FormData(form);
                const data = {};
                const productId = formData.get("productId");

                formData.forEach((value, key) => {
                    data[key] = value
                })

                fetch(form.action, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify(data)
                })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        fetch('/cart-items')
                        .then(response => response.json())
                        .then(data => {
                            updateAmounts(data.cartItems);

                            const quantityElement = document.querySelector(`#quantity-${productId}`);
                            if (quantityElement) {
                                quantityElement.textContent = data.cartItems[productId].quantity
                            }
                        })
                    } else {
                        console.error("Error updating cart", data.message);
                    }
                })
                .catch(error => console.error("Error updating cart:", error))
            }

            function updateAmounts(cartItems) {

                const itemsArray = Object.values(cartItems);

                const subTotalAmt = itemsArray.reduce((acc, item) => {
                    return acc + (item.price || 0) * (item.quantity || 0);
                }, 0);

                const totalAmt = subTotalAmt

                document.querySelector('.subTotalAmountValue').textContent = `$${subTotalAmt.toFixed(2)}`;
                document.querySelector('.totalAmountValue').textContent = `$${totalAmt.toFixed(2)}`;
            }

            function loadCartData() {
                fetch('/cart-items')
                .then(response => response.json())
                .then(data => {
                    updateAmounts(data.cartItems);
                })
                .catch(error => console.error("Error loading cart data:", error))
            }

            loadCartData();

            addButtons.forEach(button => {
                button.addEventListener('click', function(event) {
                    event.preventDefault();
                    updateCart(this, 'add-to-cart');
                })
            })

            removeButtons.forEach(button => {
                button.addEventListener('click', function(event) {
                    event.preventDefault();
                    updateCart(this, 'remove-from-cart')
                })
            })

        })
    </script>
  </head>
  <body>
    <div class="overall">
        <div class="navLine">
			<div class="topNavContainer">
				<div class="navFlex">
					<div class="navIcons">
						<a href="/products">
							<img src="../public/assets/back_icon.png" alt="Back Icon">
						</a>
						<span class="tooltip">Products</span>
					</div>
					<div class="navHeading">
						<h1 class="navHead">Order</h1>
					</div>
					<div class="navIcons">
						<a href="#">
							<img src="../public/assets/shopping-icon.png" alt=" Shopping Icon">
						</a>
						<span class="tooltip">Cart</span>
					</div>
				</div>
			</div>
		</div>
        <main class="orderPageMain">
            <% if (Object.keys(cartItems).length === 0) { %>
                <p>No products in the cart.</p>
            <% } else { %>
                <% Object.keys(cartItems).forEach(productId => { %>
                    <% const item = cartItems[productId]; %>
                    <div class="eachOrder">
                        <div class="orderItemGrid">
                            <div class="orderGridLeft">
                                <div>
                                    <a href="">
                                        <div class="orderItemImg">
                                            <div class="itemImage"><img src="<%= item.productImage %>" alt="<%= item.productName %>"></div>
                                            <span class="saleText">SALE</span>
                                        </div>
                                    </a>
                                    <div class="orderItemDetails">
                                        <div>
                                            <div class="orderItemName orderItemInfo"><%= item.productName %></div>
                                            <div class="orderItemPrice orderItemInfo">$<%= item.price %></div>
                                        </div>
                                        <div>
                                            <div class="orderItemSize orderItemInfo">Size: <%= item.productSize %></div>
                                            <div class="orderItemColor orderItemInfo">Color: <%= item.productColor %></div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="orderGridRight">
                                <div>
                                    <div>
                                        <form action="/add-to-cart" method="post">
                                            <input type="hidden" name="productId" value="<%= productId %>">
                                            <input type="hidden" name="price" value="<%= item.price %>">
                                            <input type="hidden" name="productName" value="<%= item.productName %>">
                                            <input type="hidden" name="productImage" value="<%= item.productImage %>">
                                            <input type="hidden" name="productSize" value="<%= item.productSize %>">
                                            <input type="hidden" name="productColor" value="<%= item.productColor %>">
                                            <button type="submit" class="mathIcon plusAdd">
                                                <img src="../public/assets/plus_icon.png" alt="Add Icon">
                                            </button>
                                        </form>
                                    </div>
                                    <div><p id="quantity-<%= productId %>"><%= item.quantity %></p></div>
                                    <div>
                                        <form action="/remove-from-cart" method="post">
                                            <input type="hidden" name="productId" value="<%= productId %>">
                                            <button type="submit" class="mathIcon minusRemove">
                                                <img src="../public/assets/minus_icon.png" alt="Remove Icon">
                                            </button>
                                        </form>                                        
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                <% }) %>
                <div class="promoContainer">
                    <div class="promoCodeGrid">
                        <label for="promocode" class="labelContainer promoInput">
                            PROMOCODE
                            <input
                                type="text"
                                id="promocode"
                                name="promocode"
                                placeholder="Enter the promocode"
                                class="inputField"
                                required
                            />
                        </label>
                        <div class="promoButton applyPromo ">
                            <button type="submit" class="formSubmitButton promoApply">Apply</button>
                        </div>
                    </div>
                </div>
                <div>
                    <div class="promoCodeLine">
                        <div class="calcContainer eachOrderTotalAmt">
                            <div class="subtotalText">
                                <p class="orderAmountDetails subTotalAmt">Subtotal</p>
                            </div>
                            <div>
                                <p class="orderAmountDetails subTotalAmt subTotalAmountValue">$<%= Object.values(cartItems).reduce((total, item) => total + parseFloat(item.price || 0), 0).toFixed(2) %></p>
                            </div>
                        </div>
                        <div class="deliveryContainer eachOrderTotalAmt">
                            <div class="deliveryText">
                                <p class="orderDeliveryText">Delivery</p>
                            </div>
                            <div><p class="deliveryFree">Free</p></div>
                        </div>
                    </div>
                </div>
                <div>
                    <div class="orderTotalContainer eachOrderTotalAmt">
                        <div><p class="orderAmountDetails totalAmt">Total</p></div>
                        <div><p class="orderAmountDetails totalAmt totalAmountValue">$<%= totalAmount %></p></div>
                    </div>
                </div>
                <form action="/orders/add-shipping-info" method="post" class="orderShipAction">
                    <input type="hidden" name="cartItems" value="<%= JSON.stringify(cartItems) %>">
                    <input type="hidden" name="totalAmount" value="<%= totalAmount %>">
                    <button type="submit" class="formSubmitButton orderShipInfo">Shipping & Payment Info</button>
                </form>
            <% } %>  
        </main>
    </div>
  </body>
</html>
